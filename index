      } else if (currentLang === 'fr') {
        waMessage = 
          `*Nouvelle Réservation VIP - ${appState.clinic.name}*%0A%0A` +
          `• *Patient:* ${encodeURIComponent(name)}%0A` +
          `• *Téléphone:* ${encodeURIComponent(phone)}%0A` +
