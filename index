      appState.doctors.forEach(doc => {
        const opt = document.createElement("option");
        opt.value = doc.name;
        opt.textContent = `${doc.name} (${doc.specialty})`;
        select.appendChild(opt);
      });
    }

    function onServiceChanged() {
      const select = document.getElementById("selService");
      if (!select.options.length) return;
      const activeOpt = select.options[select.selectedIndex];
      if (!activeOpt) return;

      const price = parseFloat(activeOpt.getAttribute("data-price")) || 0;
      const duration = activeOpt.getAttribute("data-duration") || 45;
      const category = activeOpt.getAttribute("data-category") || "General";

      document.getElementById("serviceDuration").textContent = currentLang === 'ar' 
        ? `المدة: ~${duration} دقيقة` 
        : `Duration: ~${duration} mins`;

      document.getElementById("serviceCategory").textContent = currentLang === 'ar'
        ? `الفئة: ${category}`
        : `Category: ${category}`;

      document.getElementById("priceFormatted").textContent = `$${price}`;
      
      const rate = appState.clinic.lbpRate || 89500;
      const lbpTotal = (price * rate).toLocaleString();
      document.getElementById("priceInLBP").textContent = `(≈ ${lbpTotal} LBP)`;
    }

