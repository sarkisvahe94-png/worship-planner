      } else {
        waMessage = 
          `*New VIP Appointment Booking - ${appState.clinic.name}*%0A%0A` +
          `• *Client Name:* ${encodeURIComponent(name)}%0A` +
          `• *WhatsApp:* ${encodeURIComponent(phone)}%0A` +
          `• *Procedure:* ${encodeURIComponent(serviceName)}%0A` +
          `• *Specialist:* ${encodeURIComponent(doctor)}%0A` +
          `• *Date:* ${encodeURIComponent(date)}%0A` +
          `• *Time Slot:* ${encodeURIComponent(timeSlot)} (Available 08:00 - 22:00)%0A` +
