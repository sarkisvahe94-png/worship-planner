<!DOCTYPE html>
<html lang="en" dir="ltr" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aura Privée Aesthetic Clinic - VIP Concierge & Booking OS</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Noto+Kufi+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --gold-primary: #d4af37;
      --gold-light: #f5e7b2;
      --gold-dark: #996d19;
      --bg-dark: #09090b;
      --card-dark: #121217;
    }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg-dark);
      color: #f3f4f6;
    }
    .font-luxury {
      font-family: 'Cinzel', serif;
    }
    [dir="rtl"] {
      font-family: 'Noto Kufi Arabic', sans-serif;
    }
    .gold-gradient {
      background: linear-gradient(135deg, #d4af37 0%, #aa771c 100%);
    }
    .gold-gradient-text {
      background: linear-gradient(135deg, #faecd0 0%, #d4af37 55%, #aa771c 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .glass-card {
      background: rgba(18, 18, 23, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(212, 175, 55, 0.15);
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #09090b;
    }
    ::-webkit-scrollbar-thumb {
      background: #27272a;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #d4af37;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-amber-500/25 selection:text-amber-200">

  <header class="sticky top-0 z-50 backdrop-blur-xl bg-neutral-950/85 border-b border-neutral-800/80 px-4 sm:px-8 py-3.5 transition-all">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
      <!-- Clinic Brand Identity -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl gold-gradient p-0.5 shadow-lg shadow-amber-500/10 flex items-center justify-center">
          <div class="w-full h-full bg-neutral-950 rounded-[14px] flex items-center justify-center">
            <span class="font-luxury font-bold text-amber-300 text-lg">A</span>
          </div>
        </div>
        <div>
          <h1 id="navClinicName" class="font-luxury font-bold tracking-wide text-base sm:text-lg text-white">Aura Privée Aesthetic Clinic</h1>
          <p id="navClinicLocation" class="text-[11px] text-amber-400/80 tracking-widest uppercase">Verdun & Dbayeh Marina, Lebanon • 7 Days (8 AM – 10 PM)</p>
        </div>
      </div>

      <!-- Controls: Portal Switcher & Language Selectors -->
      <div class="flex items-center gap-2 sm:gap-4">
        <!-- View Toggle (Client View vs Owner Admin Panel) -->
        <div class="bg-neutral-900/90 border border-neutral-800 rounded-full p-1 flex items-center text-xs shadow-inner">
          <button id="btnTabClient" onclick="switchView('client')" class="px-3.5 py-1.5 rounded-full font-medium transition bg-neutral-800 text-white shadow">
            <span id="txtClientPortal">VIP Booking</span>
          </button>
          <button id="btnTabAdmin" onclick="switchView('admin')" class="px-3.5 py-1.5 rounded-full font-medium transition text-neutral-400 hover:text-white flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
            </svg>
            <span id="txtAdminDashboard">Owner Admin</span>
          </button>
        </div>

        <!-- Language Pill Switcher -->
        <div class="flex items-center bg-neutral-900 border border-neutral-800 rounded-full p-1 text-xs">
          <button onclick="setLanguage('en')" class="lang-btn px-2.5 py-1 rounded-full text-neutral-400 hover:text-white transition font-medium" data-lang="en">EN</button>
          <button onclick="setLanguage('ar')" class="lang-btn px-2.5 py-1 rounded-full text-neutral-400 hover:text-white transition font-medium" data-lang="ar">عربي</button>
          <button onclick="setLanguage('fr')" class="lang-btn px-2.5 py-1 rounded-full text-neutral-400 hover:text-white transition font-medium" data-lang="fr">FR</button>
        </div>
      </div>
    </div>
  </header>

  <!-- Operating Hours & Status Bar -->
  <div class="bg-neutral-900/60 border-b border-neutral-800/40 py-2 px-4 text-center text-xs text-neutral-400">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-4 text-[11px] sm:text-xs">
      <span class="inline-flex items-center gap-1.5 text-emerald-400 font-medium">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span id="operatingHoursNotice">Open 7 Days a Week: Mon - Sun (8:00 AM - 10:00 PM)</span>
      </span>
      <span class="hidden sm:inline text-neutral-600">•</span>
      <span class="text-neutral-400" id="instantConfirmationBadge">⚡ Instant VIP WhatsApp Confirmation</span>
    </div>
  </div>

  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">

    <!-- ========================================================================= -->
    <!-- VIEW 1: CLIENT VIP BOOKING INTERFACE                                      -->
    <!-- ========================================================================= -->
    <section id="viewClient" class="block transition-all duration-300">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Column: Clinic Hero, Ambience & Location -->
        <div class="lg:col-span-5 space-y-6">
          <div class="glass-card rounded-3xl p-6 sm:p-8 relative overflow-hidden shadow-2xl">
            <div class="absolute -top-24 -left-24 w-60 h-60 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold uppercase tracking-wider mb-4">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
              <span id="badgeVerified">Accredited Aesthetic Center</span>
            </div>

            <h2 id="clientHeroTitle" class="text-3xl sm:text-4xl font-luxury font-bold tracking-tight text-white mb-4 leading-tight">
              Bespoke Beauty & Wellness Reservations
            </h2>

            <p id="clientHeroDesc" class="text-sm text-neutral-400 leading-relaxed mb-6">
              Experience discreet, personalized aesthetic medical procedures. Select your desired treatment, choose your preferred consultant, and reserve a guaranteed slot directly with our reception concierge.
            </p>

            <div class="space-y-4 pt-4 border-t border-neutral-800/80 text-xs text-neutral-300">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-2xl bg-neutral-900 border border-neutral-800 flex items-center justify-center text-amber-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <div>
                  <div class="font-medium text-white" id="infoHoursTitle">Continuous 7-Day Operations</div>
                  <div class="text-neutral-400" id="infoHoursSubtitle">Daily sessions from 08:00 AM to 10:00 PM (No weekend closure)</div>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-2xl bg-neutral-900 border border-neutral-800 flex items-center justify-center text-amber-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                </div>
                <div>
                  <div class="font-medium text-white" id="infoLocationTitle">Prime Lebanese Locations</div>
                  <div class="text-neutral-400" id="infoLocationSubtitle">Verdun & Dbayeh Marina Highway Medical Centers</div>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-2xl bg-neutral-900 border border-neutral-800 flex items-center justify-center text-amber-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                </div>
                <div>
                  <div class="font-medium text-white" id="infoPaymentsTitle">Payment Freedom in Lebanon</div>
                  <div class="text-neutral-400" id="infoPaymentsSubtitle">Whish Money, OMT Transfer, Cash USD/LBP, or Card</div>
                </div>
              </div>
            </div>

            <!-- WhatsApp Direct Floating Card -->
            <div class="mt-8 p-4 rounded-2xl bg-emerald-950/20 border border-emerald-900/50 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
                <span class="text-xs font-medium text-emerald-300" id="chatHelpText">Direct WhatsApp Concierge Active</span>
              </div>
              <a id="btnDirectWaCall" href="#" target="_blank" class="text-xs font-semibold text-emerald-400 hover:text-emerald-300 underline">Chat Now</a>
            </div>
          </div>
        </div>

        <!-- Right Column: Interactive Step-by-Step Booking Form -->
        <div class="lg:col-span-7">
          <div class="bg-neutral-900 border border-neutral-800/90 rounded-3xl p-6 sm:p-8 shadow-2xl relative">
            <h3 id="formHeading" class="text-xl font-luxury font-bold text-white mb-6 pb-3 border-b border-neutral-800 flex items-center justify-between">
              <span>Appointment Reservation</span>
              <span class="text-xs font-sans text-amber-400 font-normal px-2.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/20">VIP Fast-Track</span>
            </h3>

            <form id="bookingForm" onsubmit="submitClientBooking(event)" class="space-y-6">

              <!-- Step 1: Treatment Selector -->
              <div>
                <label id="lblSelectService" class="block text-xs uppercase tracking-wider text-neutral-400 font-semibold mb-2">1. Select Procedure or Treatment</label>
                <select id="selService" required onchange="onServiceChanged()" class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-4 py-3.5 text-sm text-neutral-100 focus:outline-none focus:border-amber-400 transition">
                  <!-- Injected via JavaScript -->
                </select>
                <div id="serviceDetailPreview" class="mt-2 text-xs text-neutral-400 flex justify-between items-center px-1">
                  <span id="serviceDuration">Duration: ~45 mins</span>
                  <span id="serviceCategory" class="text-amber-400">Category: Aesthetic Medicine</span>
                </div>
              </div>

              <!-- Step 2: Doctor/Specialist Picker -->
              <div>
                <label id="lblSelectDoctor" class="block text-xs uppercase tracking-wider text-neutral-400 font-semibold mb-2">2. Choosing Doctor / Specialist</label>
                <select id="selDoctor" required class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-4 py-3.5 text-sm text-neutral-100 focus:outline-none focus:border-amber-400 transition">
                  <!-- Injected via JavaScript -->
                </select>
              </div>

              <!-- Step 3: Date & 7-Day 08:00 - 22:00 Time Slots -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label id="lblSelectDate" class="block text-xs uppercase tracking-wider text-neutral-400 font-semibold mb-2">3. Preferred Day (Mon - Sun)</label>
                  <input type="date" id="inpDate" required onchange="generateTimeSlots()" class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-4 py-3 text-sm text-neutral-100 focus:outline-none focus:border-amber-400 transition">
                  <p class="text-[11px] text-neutral-500 mt-1" id="lblEverydayNote">Open 7 days a week including weekends</p>
                </div>
                <div>
                  <label id="lblSelectSlot" class="block text-xs uppercase tracking-wider text-neutral-400 font-semibold mb-2">4. Available Slot (08:00 - 22:00)</label>
                  <select id="selTimeSlot" required class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-4 py-3 text-sm text-neutral-100 focus:outline-none focus:border-amber-400 transition">
                    <!-- 30-min slots generated from 08:00 to 22:00 -->
                  </select>
                  <p class="text-[11px] text-emerald-400/90 mt-1" id="slotAvailabilityNote">Strict 30-min precision intervals</p>
                </div>
              </div>

              <!-- Step 4: Patient Details -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
                <div>
                  <label id="lblName" class="block text-xs uppercase tracking-wider text-neutral-400 font-semibold mb-2">Full Name</label>
                  <input type="text" id="inpName" required placeholder="e.g. Sarah Kassir" class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-4 py-3 text-sm text-neutral-100 focus:outline-none focus:border-amber-400 transition">
                </div>
                <div>
                  <label id="lblPhone" class="block text-xs uppercase tracking-wider text-neutral-400 font-semibold mb-2">WhatsApp Mobile Number</label>
                  <input type="tel" id="inpPhone" required placeholder="+961 70 123456" class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-4 py-3 text-sm text-neutral-100 focus:outline-none focus:border-amber-400 transition">
                </div>
              </div>

              <!-- Step 5: Lebanese & Middle East Settlement Method -->
              <div>
                <label id="lblPaymentMethod" class="block text-xs uppercase tracking-wider text-neutral-400 font-semibold mb-2">5. Settlement / Deposit Preference</label>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                  <label class="cursor-pointer border border-neutral-800 rounded-xl p-3 flex flex-col items-center justify-center text-center hover:border-amber-400 transition bg-neutral-950/60 has-[:checked]:border-amber-400 has-[:checked]:bg-amber-400/10">
                    <input type="radio" name="payOption" value="Cash on Arrival" checked class="hidden">
                    <span class="text-xs font-semibold text-white">Cash / Desk</span>
                    <span class="text-[10px] text-neutral-400 mt-0.5">USD or LBP</span>
                  </label>
                  <label class="cursor-pointer border border-neutral-800 rounded-xl p-3 flex flex-col items-center justify-center text-center hover:border-amber-400 transition bg-neutral-950/60 has-[:checked]:border-amber-400 has-[:checked]:bg-amber-400/10">
                    <input type="radio" name="payOption" value="Whish Money" class="hidden">
                    <span class="text-xs font-semibold text-white">Whish Money</span>
                    <span class="text-[10px] text-amber-300 mt-0.5">Instant Mobile</span>
                  </label>
                  <label class="cursor-pointer border border-neutral-800 rounded-xl p-3 flex flex-col items-center justify-center text-center hover:border-amber-400 transition bg-neutral-950/60 has-[:checked]:border-amber-400 has-[:checked]:bg-amber-400/10">
                    <input type="radio" name="payOption" value="OMT Transfer" class="hidden">
                    <span class="text-xs font-semibold text-white">OMT Transfer</span>
                    <span class="text-[10px] text-neutral-400 mt-0.5">Lebanon Branch</span>
                  </label>
                  <label class="cursor-pointer border border-neutral-800 rounded-xl p-3 flex flex-col items-center justify-center text-center hover:border-amber-400 transition bg-neutral-950/60 has-[:checked]:border-amber-400 has-[:checked]:bg-amber-400/10">
                    <input type="radio" name="payOption" value="Credit Card" class="hidden">
                    <span class="text-xs font-semibold text-white">Credit Card</span>
                    <span class="text-[10px] text-neutral-400 mt-0.5">Visa / MC</span>
                  </label>
                </div>
              </div>

              <!-- Live Pricing & Order Summary Box -->
              <div class="bg-neutral-950 border border-neutral-800 rounded-2xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div>
                  <span class="text-[11px] text-neutral-500 uppercase tracking-widest block" id="lblEstimatedTotal">Estimated Consultation Total</span>
                  <div class="flex items-baseline gap-2">
                    <span id="priceFormatted" class="text-2xl font-bold text-amber-300 font-luxury">$130</span>
                    <span id="priceInLBP" class="text-xs text-neutral-400 font-medium">(≈ 11,635,000 LBP)</span>
                  </div>
                </div>
                <div class="text-xs text-neutral-400 text-left sm:text-right">
                  <span class="inline-flex items-center gap-1 text-emerald-400 font-medium">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                    <span id="lblNoHold">No upfront card lock</span>
                  </span>
                  <div class="text-[11px] text-neutral-500" id="lblWhatsappForward">Auto-routes to Clinic WhatsApp</div>
                </div>
              </div>

              <!-- Submit Button -->
              <button type="submit" class="w-full py-4 gold-gradient text-neutral-950 font-bold rounded-2xl text-sm tracking-wider uppercase hover:opacity-95 transition shadow-xl shadow-amber-500/10 flex items-center justify-center gap-2 group">
                <span id="btnSubmitReservation">Confirm & Reserve via WhatsApp</span>
                <svg class="w-4 h-4 transform group-hover:translate-x-1 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </button>

              <div class="text-center text-[11px] text-neutral-500">
                <span id="lblPrivacyNote">Guaranteed strict medical privacy. Direct VIP confirmation from clinic management.</span>
              </div>
            </form>
          </div>
        </div>

      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- VIEW 2: CLINIC OWNER ADMINISTRATIVE DASHBOARD & LIVE EDITOR                -->
    <!-- ========================================================================= -->
    <section id="viewAdmin" class="hidden transition-all duration-300">
      <div class="space-y-8">
        
        <!-- Admin Header -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-3xl p-6 sm:p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              Admin Control Live Mode
            </div>
            <h2 class="text-2xl font-luxury font-bold text-white">Clinic Business Management & Customizer</h2>
            <p class="text-xs text-neutral-400 mt-1">All updates here instantly change your public booking website and persist safely in browser storage.</p>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="restoreDefaults()" class="px-4 py-2 rounded-xl border border-neutral-700 bg-neutral-800 text-xs font-medium text-neutral-300 hover:text-white transition">
              Reset to Defaults
            </button>
            <button onclick="switchView('client')" class="px-5 py-2.5 rounded-xl gold-gradient text-neutral-950 text-xs font-bold uppercase tracking-wider hover:opacity-90 transition shadow">
              Preview Client View
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          
          <!-- Column 1: Clinic Profile Settings (Name, Phone, WhatsApp, Currency, Rate) -->
          <div class="lg:col-span-5 space-y-6">
            <div class="bg-neutral-900 border border-neutral-800 rounded-3xl p-6 shadow-lg">
              <h3 class="text-base font-semibold text-white mb-4 pb-2 border-b border-neutral-800 flex items-center justify-between">
                <span>Clinic Profile & Currency</span>
                <span class="text-xs text-amber-400 font-normal">Editable</span>
              </h3>

              <div class="space-y-4 text-xs">
                <div>
                  <label class="block text-neutral-400 uppercase tracking-wider mb-1 font-medium">Clinic Brand Name</label>
                  <input type="text" id="admClinicName" oninput="updateClinicMeta()" class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-3.5 py-2.5 text-white focus:outline-none focus:border-amber-400">
                </div>

                <div>
                  <label class="block text-neutral-400 uppercase tracking-wider mb-1 font-medium">Reception WhatsApp Number (International format)</label>
                  <input type="text" id="admClinicWhatsApp" oninput="updateClinicMeta()" placeholder="96170123456" class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-3.5 py-2.5 text-white focus:outline-none focus:border-amber-400">
                  <span class="text-[10px] text-neutral-500">Without '+' or spaces (e.g. 96170123456 or 971501234567)</span>
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="block text-neutral-400 uppercase tracking-wider mb-1 font-medium">Primary Currency</label>
                    <select id="admCurrency" onchange="updateClinicMeta()" class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-3 py-2.5 text-white focus:outline-none focus:border-amber-400">
                      <option value="USD">USD ($)</option>
                      <option value="LBP">LBP (L.L.)</option>
                      <option value="AED">AED (د.إ)</option>
                      <option value="SAR">SAR (ر.س)</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-neutral-400 uppercase tracking-wider mb-1 font-medium">USD to LBP Exchange Rate</label>
                    <input type="number" id="admLbpRate" oninput="updateClinicMeta()" placeholder="89500" class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-3 py-2.5 text-white focus:outline-none focus:border-amber-400">
                  </div>
                </div>

                <div>
                  <label class="block text-neutral-400 uppercase tracking-wider mb-1 font-medium">Operating Hours Label</label>
                  <input type="text" id="admOperatingHours" oninput="updateClinicMeta()" value="Daily 08:00 AM - 10:00 PM (Monday through Sunday)" class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-3.5 py-2.5 text-white focus:outline-none focus:border-amber-400">
                </div>

                <div>
                  <label class="block text-neutral-400 uppercase tracking-wider mb-1 font-medium">Clinic Physical Address / Branches</label>
                  <input type="text" id="admClinicAddress" oninput="updateClinicMeta()" value="Verdun Medical Plaza & Dbayeh Marina Highway, Lebanon" class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-3.5 py-2.5 text-white focus:outline-none focus:border-amber-400">
                </div>
              </div>
            </div>

            <!-- Doctor / Specialist Team Management -->
            <div class="bg-neutral-900 border border-neutral-800 rounded-3xl p-6 shadow-lg">
              <div class="flex items-center justify-between mb-4 pb-2 border-b border-neutral-800">
                <h3 class="text-base font-semibold text-white">Doctors & Practitioners</h3>
                <button onclick="openDoctorModal()" class="px-2.5 py-1 rounded-lg bg-amber-400/10 text-amber-300 border border-amber-400/30 text-xs hover:bg-amber-400/20 transition">
                  + Add Specialist
                </button>
              </div>

              <div id="doctorList" class="space-y-3">
