    // Generate 7-day 8:00 AM to 10:00 PM time slots (in 30-min intervals)
    function generateTimeSlots() {
      const slotSelect = document.getElementById("selTimeSlot");
      slotSelect.innerHTML = "";
      
      const startHour = 8;  // 8:00 AM
      const endHour = 22;   // 10:00 PM

      for (let hour = startHour; hour < endHour; hour++) {
        for (let min of [0, 30]) {
          const hStr = hour < 10 ? `0${hour}` : `${hour}`;
          const mStr = min === 0 ? "00" : `${min}`;
          
          const period = hour >= 12 ? 'PM' : 'AM';
          const displayH = hour % 12 === 0 ? 12 : hour % 12;
          const displaySlot = `${displayH}:${mStr} ${period} (${hStr}:${mStr})`;

          const opt = document.createElement("option");
          opt.value = `${hStr}:${mStr}`;
          opt.textContent = displaySlot;
          slotSelect.appendChild(opt);
        }
      }
      const finalOpt = document.createElement("option");
      finalOpt.value = "22:00";
      finalOpt.textContent = "10:00 PM (22:00)";
      slotSelect.appendChild(finalOpt);
    }

    function initDatePicker() {
      const dateInput = document.getElementById("inpDate");
      const today = new Date();
      const yyyy = today.getFullYear();
      const mm = String(today.getMonth() + 1).padStart(2, '0');
      const dd = String(today.getDate()).padStart(2, '0');
      dateInput.min = `${yyyy}-${mm}-${dd}`;
      dateInput.value = `${yyyy}-${mm}-${dd}`;
    }

    function renderClientServices() {
      const select = document.getElementById("selService");
      select.innerHTML = "";

      appState.services.forEach(srv => {
        let label = srv.nameEn;
        if (currentLang === 'ar' && srv.nameAr) label = srv.nameAr;
        if (currentLang === 'fr' && srv.nameFr) label = srv.nameFr;

        const opt = document.createElement("option");
        opt.value = srv.id;
        opt.setAttribute("data-price", srv.price);
        opt.setAttribute("data-duration", srv.duration);
        opt.setAttribute("data-category", srv.category);
        opt.textContent = `${label} — $${srv.price}`;
        select.appendChild(opt);
      });

      onServiceChanged();
    }

    function renderClientDoctors() {
      const select = document.getElementById("selDoctor");
