          `• *Estimated Total:* ${encodeURIComponent(priceText)} ${encodeURIComponent(lbpEstimate)}%0A%0A` +
          `_Please confirm slot availability and booking receipt._`;
      }

      const waUrl = `https://wa.me/${clinicPhone}?text=${waMessage}`;
      showToast("Redirecting to Clinic WhatsApp Concierge...");
      window.open(waUrl, '_blank');
    }

    function showToast(msg) {
      const toast = document.getElementById("toast");
      document.getElementById("toastMessage").textContent = msg;
      toast.classList.remove("translate-y-24", "opacity-0");
      setTimeout(() => {
        toast.classList.add("translate-y-24", "opacity-0");
      }, 3500);
    }

    // Window Onload Startup
    window.onload = function() {
      loadState();
      initDatePicker();
      generateTimeSlots();
      renderClientServices();
      renderClientDoctors();
      setLanguage('en');
    };
  </script>
</body>
