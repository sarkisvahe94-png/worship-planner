      const srvTbody = document.getElementById("servicesTableBody");
      srvTbody.innerHTML = "";

      appState.services.forEach(srv => {
        const tr = document.createElement("tr");
        tr.className = "hover:bg-neutral-800/40 transition";
        tr.innerHTML = `
          <td class="py-3 px-3">
            <div class="font-medium text-white">${srv.nameEn}</div>
            <div class="text-[10px] text-neutral-400" dir="rtl">${srv.nameAr || ''}</div>
          </td>
          <td class="py-3 px-3"><span class="px-2 py-0.5 rounded bg-neutral-800 text-neutral-300 text-[10px]">${srv.category}</span></td>
          <td class="py-3 px-3 text-neutral-300">${srv.duration} mins</td>
          <td class="py-3 px-3 font-semibold text-amber-300">$${srv.price}</td>
          <td class="py-3 px-3 text-right space-x-1">
            <button onclick="editService('${srv.id}')" class="px-2 py-1 rounded bg-neutral-800 text-amber-400 hover:text-white text-[11px]">Edit</button>
            <button onclick="deleteService('${srv.id}')" class="px-2 py-1 rounded bg-neutral-800 text-red-400 hover:text-red-300 text-[11px]">Del</button>
          </td>
        `;
        srvTbody.appendChild(tr);
      });

      const docList = document.getElementById("doctorList");
      docList.innerHTML = "";

      appState.doctors.forEach(doc => {
        const item = document.createElement("div");
        item.className = "p-3 bg-neutral-950/70 border border-neutral-800/80 rounded-xl flex items-center justify-between";
        item.innerHTML = `
          <div>
            <div class="text-xs font-semibold text-white">${doc.name}</div>
            <div class="text-[10px] text-neutral-400">${doc.specialty}</div>
          </div>
          <button onclick="deleteDoctor('${doc.id}')" class="text-neutral-500 hover:text-red-400 p-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
          </button>
        `;
        docList.appendChild(item);
      });
    }

    function renderBookingLogs() {
      const container = document.getElementById("bookingLogsList");
      if (!appState.bookings || appState.bookings.length === 0) {
        container.innerHTML = `<div class="text-xs text-neutral-500 py-3 text-center">No client appointments logged yet.</div>`;
        return;
      }
      container.innerHTML = appState.bookings.slice().reverse().map(b => `
        <div class="p-3 bg-neutral-950/80 border border-neutral-800/60 rounded-xl text-xs flex justify-between items-center">
          <div>
            <div class="font-medium text-white">${b.name} <span class="text-neutral-400 text-[11px]">(${b.phone})</span></div>
            <div class="text-[10px] text-amber-400">${b.service} • ${b.doctor}</div>
            <div class="text-[10px] text-neutral-500">${b.date} at ${b.time} • Pay: ${b.payment}</div>
          </div>
          <div class="text-right">
            <div class="text-amber-300 font-bold">${b.price}</div>
            <div class="text-[9px] text-neutral-500">${b.timestamp || ''}</div>
          </div>
        </div>
      `).join('');
    }

    function clearBookingLogs() {
      if (confirm("Clear local booking history?")) {
        appState.bookings = [];
        saveState();
        renderBookingLogs();
        showToast("Booking history cleared");
      }
    }

    // Modal Operations
    function openServiceModal(srvId = null) {
      const modal = document.getElementById("serviceModal");
      const title = document.getElementById("modalServiceTitle");
      const idInput = document.getElementById("modalServiceId");

      if (srvId) {
        const srv = appState.services.find(s => s.id === srvId);
        if (srv) {
          title.textContent = "Edit Procedure";
          idInput.value = srv.id;
          document.getElementById("modalServiceNameEn").value = srv.nameEn;
          document.getElementById("modalServiceNameAr").value = srv.nameAr || '';
          document.getElementById("modalServiceNameFr").value = srv.nameFr || '';
          document.getElementById("modalServicePrice").value = srv.price;
          document.getElementById("modalServiceDuration").value = srv.duration;
          document.getElementById("modalServiceCategory").value = srv.category;
        }
      } else {
        title.textContent = "Add New Treatment";
        idInput.value = "";
        document.getElementById("serviceForm").reset();
      }
      modal.classList.remove("hidden");
      modal.classList.add("flex");
    }

    function closeServiceModal() {
      const modal = document.getElementById("serviceModal");
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }

    function saveService(event) {
      event.preventDefault();
      const id = document.getElementById("modalServiceId").value;
      const srvData = {
        id: id ? id : 'srv-' + Date.now(),
        nameEn: document.getElementById("modalServiceNameEn").value,
        nameAr: document.getElementById("modalServiceNameAr").value,
        nameFr: document.getElementById("modalServiceNameFr").value,
        price: parseFloat(document.getElementById("modalServicePrice").value) || 0,
        duration: parseInt(document.getElementById("modalServiceDuration").value) || 30,
        category: document.getElementById("modalServiceCategory").value || "General"
      };

      if (id) {
        const idx = appState.services.findIndex(s => s.id === id);
        if (idx !== -1) appState.services[idx] = srvData;
      } else {
        appState.services.push(srvData);
      }

      saveState();
      closeServiceModal();
      renderAdminTables();
      renderClientServices();
      showToast("Treatment catalog updated");
    }

    function editService(id) {
      openServiceModal(id);
    }

    function deleteService(id) {
      if (confirm("Delete this treatment from the menu?")) {
        appState.services = appState.services.filter(s => s.id !== id);
        saveState();
        renderAdminTables();
        renderClientServices();
        showToast("Service deleted");
      }
    }

    function openDoctorModal() {
      document.getElementById("doctorForm").reset();
      const modal = document.getElementById("doctorModal");
      modal.classList.remove("hidden");
      modal.classList.add("flex");
    }

    function closeDoctorModal() {
      const modal = document.getElementById("doctorModal");
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }

    function saveDoctor(event) {
      event.preventDefault();
      const newDoc = {
        id: 'doc-' + Date.now(),
        name: document.getElementById("modalDoctorName").value,
        specialty: document.getElementById("modalDoctorSpecialty").value
      };

      appState.doctors.push(newDoc);
      saveState();
      closeDoctorModal();
      renderAdminTables();
      renderClientDoctors();
      showToast("Specialist added to team");
    }

    function deleteDoctor(id) {
      if (confirm("Remove this specialist from availability?")) {
        appState.doctors = appState.doctors.filter(d => d.id !== id);
        saveState();
        renderAdminTables();
        renderClientDoctors();
        showToast("Specialist removed");
      }
    }

    function switchView(target) {
      const clientView = document.getElementById("viewClient");
      const adminView = document.getElementById("viewAdmin");
      const btnClient = document.getElementById("btnTabClient");
      const btnAdmin = document.getElementById("btnTabAdmin");

      if (target === 'client') {
        clientView.classList.remove("hidden");
        adminView.classList.add("hidden");
        btnClient.classList.add("bg-neutral-800", "text-white", "shadow");
        btnClient.classList.remove("text-neutral-400");
        btnAdmin.classList.add("text-neutral-400");
        btnAdmin.classList.remove("bg-neutral-800", "text-white", "shadow");
        renderClientServices();
        renderClientDoctors();
      } else {
        adminView.classList.remove("hidden");
        clientView.classList.add("hidden");
        btnAdmin.classList.add("bg-neutral-800", "text-white", "shadow");
        btnAdmin.classList.remove("text-neutral-400");
        btnClient.classList.add("text-neutral-400");
        btnClient.classList.remove("bg-neutral-800", "text-white", "shadow");
        renderAdminTables();
        renderBookingLogs();
      }
    }

    function setLanguage(lang) {
      currentLang = lang;
      const html = document.documentElement;
      
      document.querySelectorAll(".lang-btn").forEach(btn => {
        if (btn.getAttribute("data-lang") === lang) {
          btn.classList.add("bg-neutral-800", "text-amber-300");
          btn.classList.remove("text-neutral-400");
        } else {
          btn.classList.remove("bg-neutral-800", "text-amber-300");
          btn.classList.add("text-neutral-400");
        }
      });

      if (lang === 'ar') {
        html.setAttribute("dir", "rtl");
        html.setAttribute("lang", "ar");
      } else {
        html.setAttribute("dir", "ltr");
        html.setAttribute("lang", lang);
      }

      const dict = i18n[lang] || i18n.en;
      Object.keys(dict).forEach(key => {
        const el = document.getElementById(key);
        if (el) el.textContent = dict[key];
      });

      renderClientServices();
      renderClientDoctors();
    }

    function submitClientBooking(event) {
      event.preventDefault();
      
      const serviceSelect = document.getElementById("selService");
      const serviceName = serviceSelect.options[serviceSelect.selectedIndex].text;
      const doctor = document.getElementById("selDoctor").value;
      const date = document.getElementById("inpDate").value;
      const timeSlot = document.getElementById("selTimeSlot").value;
      const name = document.getElementById("inpName").value;
      const phone = document.getElementById("inpPhone").value;
